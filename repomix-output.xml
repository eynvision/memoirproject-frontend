    path: "/memoirs",
    method: "POST",
    body,
    schema: memoirSchema,
  });
}

export async function fetchMemoir(
  id: string,
  options: ApiRequestCaching = {}
): Promise<Memoir> {
  return apiRequest({
    path: `/memoirs/${id}`,
    schema: memoirSchema,
    ...options,
  });
}

export async function publishMemoir(id: string): Promise<Memoir> {
  return apiRequest({
    path: `/memoirs/${id}/publish`,
    method: "POST",
    schema: memoirSchema,
  });
}
